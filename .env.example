# ---- Public (safe in the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx            # Supabase → Project Settings → API Keys (publishable/anon)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app             # optional on Vercel (falls back to the production URL)
NEXT_PUBLIC_PLATFORM_NAME=Voltaje
NEXT_PUBLIC_ROOT_DOMAIN=                                    # e.g. voltaje.app → enables operator1.voltaje.app subdomains

# ---- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=                                  # Supabase → Project Settings → API Keys → service_role / secret
STRIPE_SECRET_KEY=sk_test_xxx                               # Stripe Dashboard (Test mode) → Developers → API keys
STRIPE_WEBHOOK_SECRET=whsec_xxx                             # endpoint: /api/webhooks/stripe   ("Your account" events)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx                     # endpoint: /api/webhooks/stripe-connect ("Connected accounts" events)
CRON_SECRET=                                                # random string; Vercel Cron sends it as Bearer token
APP_ENCRYPTION_KEY=                                         # 32 random bytes, base64 (openssl rand -base64 32)
ALLOW_SIMULATED_PAYMENTS=true                               # simulated payments only ever work on simulated machines
